{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tree-kg-build-request.schema.json",
  "title": "TreeKG build request",
  "type": "object",
  "required": ["schema_version", "job_id", "user_id", "book", "source"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "book": {
      "type": "object",
      "required": ["book_id", "title"],
      "properties": {
        "book_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "category": {"type": "string", "maxLength": 100},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["chunks_path"],
      "properties": {
        "chunks_path": {"type": "string", "minLength": 1},
        "format": {"enum": ["tree_kg_jsonl", "textbook_pipeline_jsonl"]}
      },
      "additionalProperties": false
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
