 {"source": "失眠", "target": "急躁易怒", "type": "related", "description": "失眠与急躁易怒在中医临床中常共见于心肝火旺、肝火上炎等证候，描述中明确指出两者关联密切，语义相似度高。"}, {"source": "四诊合参", "target": "病位", "type": "applies-to", "description": "四诊合参综合运用四诊信息以确定病位，是方法用于对象的典型关系。"}, {"source": "形体官窍", "target": "生命活动", "type": "related", "description": "形体官窍是生命活动的物质基础和外在表现，二者密切关联，语义高度相似，但无严格的先修、包含或同义关系。"}, {"source": "生命活动", "target": "相侮", "type": "related", "description": "生命活动与相侮同属中医学范畴，但前者为整体功能概念，后者为五行异常传变机制，语义高度相关但无强语义关系。"}, {"source": "生命活动", "target": "病理传变", "type": "related", "description": "生命活动是中医生理核心，病理传变是疾病传变机制，二者紧密对应、相互影响，但无更强语义关系。"}, {"source": "疾病", "target": "病因", "type": "prerequisite", "description": "病因是导致疾病的原因，掌握病因是理解疾病病理变化的必要条件。"}, {"source": "形体官窍", "target": "病位", "type": "related", "description": "形体官窍作为藏象概念与病位作为辨证要素在中医理论中相互关联，但无严格先修或包含关系。"}, {"source": "形体官窍", "target": "疾病", "type": "related", "description": "形体官窍是疾病外在表现的观察载体，两者通过藏象学说中“从外知内”的思维紧密相关，语义高度相似。"}, {"source": "病位", "target": "精气血津液", "type": "related", "description": "病位是辨证要素，精气血津液是物质基础，两者通过脏腑、经络等间接关联，但无直接先修、包含或同义关系。"}, {"source": "气滞血瘀", "target": "疾病", "type": "example-of", "description": "气滞血瘀是疾病的一种具体病理状态或证候，属于疾病的实例。"}, {"source": "疾病", "target": "经络", "type": "related", "description": "均属中医基础理论核心概念，疾病病理过程常涉及经络阻滞，但无先修、包含等更强语义关系。"}, {"source": "演绎推理", "target": "生命活动", "type": "applies-to", "description": "演绎推理是五行学说中用于归类和分析生命活动的逻辑方法。"}, {"source": "疾病", "target": "病位", "type": "part-of", "description": "病位是疾病辨证的核心要素之一，疾病包含病位这一组成概念。"}, {"source": "生命活动", "target": "病因", "type": "related", "description": "生命活动与病因在中医学中相互关联：病因破坏生命活动的平衡导致疾病。"}, {"source": "疾病", "target": "病性", "type": "related", "description": "疾病是整体病理过程，病性是疾病在特定阶段的病理性质，二者紧密关联，但并非严格包含或先修关系。"}]}