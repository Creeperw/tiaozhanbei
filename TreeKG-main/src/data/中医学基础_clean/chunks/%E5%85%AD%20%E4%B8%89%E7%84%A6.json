rce": "中焦", "target": "卫气", "type": "related", "description": "中焦是卫气生成之源，卫气由脾胃化生的水谷精气所化，两者关系密切但非严格先修或包含。"}, {"source": "卫气", "target": "寒热", "type": "related", "description": "卫气抗邪于肌表可表现为恶寒发热等寒热症状，二者在中医病机与辨证中相互关联。"}, {"source": "《素问·阴阳应象大论》", "target": "气血", "type": "related", "description": "两者均为中医基础理论核心概念，阴阳学说与气血理论在诊断、体质、发病机制上相互关联，但无直接先修、包含或用途等强关系。"}, {"source": "人体之气", "target": "气", "type": "synonym", "description": "人体之气与气在中医语境下几乎完全等同，均指构成人体并维持生命活动的基本物质。"}, {"source": "外邪", "target": "肺", "type": "related", "description": "外邪是中医病因，肺是脏腑；外邪常侵犯肺导致肺气宣肃失职，肺的卫气功能抵御外邪，两者关系明确。"}, {"source": "先天精气", "target": "气", "type": "part-of", "description": "先天精气是气的主要生成来源之一，属于气的组成部分。"}, {"source": "外邪", "target": "肝", "type": "related", "description": "外邪是致病因素，肝是受邪脏腑之一，常见外邪犯肝导致肝胆湿热等证，存在病因-病位关联。"}, {"source": "二阴", "target": "肝", "type": "related", "description": "二阴描述明确指出前阴与肝密切相关，且语义相似度极高，但无更强关系如先修或部分包含。"}, {"source": "外环境", "target": "气血津液", "type": "related", "description": "外环境影响人体脏腑功能，进而影响气血津液的生成与运行，两者有密切关联但非直接先修、包含或用途等强关系。"}, {"source": "气滞血瘀", "target": "气血", "type": "related", "description": "气滞血瘀是气血运行失常的典型病理状态，两者语义高度相关且概念层级紧密，属于强相关关系。"}, {"source": "下焦", "target": "肝", "type": "related", "description": "下焦病证涉及肝肾，且下焦与肾密切相关，肝与肾精血同源，两者在中医理论中通过肾间接关联，属于教学常识中的强相关。"}, {"source": "后天之本", "target": "气血津液", "type": "related", "description": "脾（后天之本）是气血津液化生的关键脏腑，描述中明确指出脾运化水谷精微以生气血津液，二者有强功能关联。"}, {"source": "人体之气", "target": "气化", "type": "prerequisite", "description": "人体之气的运动是气化的前提条件，气化是气运动变化所推动的功能，教材明确将气作为气化的物质基础。"}, {"source": "上焦", "target": "肝", "type": "related", "description": "上焦与肝在中医理论中均参与气血运行与气机调畅，功能上相互关联。"}, {"source": "口唇青紫", "target": "气血津液", "type": "example-of", "description": "口唇青紫是气血津液失调中血瘀的典型体征表现。"}, {"source": "中病即止", "target": "气血", "type": "related", "description": "中病即止原则涉及保护津液与正气，与气血津液理论紧密相关，但非直接先修、包含或用途关系。"}, {"source": "人体之气", "target": "气虚", "type": "related", "description": "人体之气是根本物质，气虚是气的病理状态，两者直接相关。"}, {"source": "先天精气", "target": "气化", "type": "related", "description": "先天精气为气化提供物质基础和原动力，气化依赖先天精气，二者在气的生成与功能活动中紧密关联。"}, {"source": "下焦", "target": "肺", "type": "related", "description": "肺与下焦协同参与水液代谢和气机运行，功能密切相关。"}, {"source": "人体之气", "target": "气机", "type": "related", "description": "人体之气是气的物质基础，气机是气的运动机制，两者紧密相关，共同构成中医气学理论的核心。"}, {"source": "卫气", "target": "津液不足", "type": "related", "description": "卫气与津液不足在中医理论中相互影响：卫气固摄失常可致津液流失，津液亏耗亦可影响卫气化源，但无直接包含或先修关系。"}, {"source": "四诊", "target": "肝", "type": "related", "description": "四诊是中医诊断方法，肝是五脏之一，两者在中医诊断中密切相关，四诊用于获取肝的病理信息。"}, {"source": "先天精气", "target": "气机", "type": "related", "description": "先天精气为气机提供原动力，两者密切相关但非包含或前置关系。"}, {"source": "幽门", "target": "气化", "type": "related", "description": "幽门是消化系统解剖枢纽，气化是物质转化功能，二者在消化吸收过程中间接关联，但无明确先修或包含关系。"}, {"source": "气脱", "target": "气血", "type": "related", "description": "气脱是气血中气的严重失调状态，与气血概念密切相关。"}, {"source": "先天精气", "target": "气虚", "type": "related", "description": "先天精气是人体之气的原始物质，其盛衰直接影响气的强弱；气虚是气不足的病理状态，二者在气的生成与运动方面紧密关联。"}, {"source": "气能生津", "target": "气血", "type": "related", "description": "气能生津是气对津液生成的作用，属于气血津液理论的一部分，与气血概念高度相关，但非包含或先修关系。"}, {"source": "心血瘀阻", "target": "气血", "type": "related", "description": "心血瘀阻是血瘀证，与气血中的血直接相关，且气滞可致血瘀，二者在病理上紧密关联。"}, {"source": "心肺", "target": "气血津液", "type": "related", "description": "心肺功能与气血津液的生成、输布密切相关，但无严格先修、包含或等同关系。"}, {"source": "水", "target": "滋润", "type": "related", "description": "水与滋润语义高度相似，水是五行之一，其特性即为滋润，二者直接关联。"}, {"source": "气脱", "target": "水", "type": "related", "description": "气脱与水在中医理论中通过肾、气与津液代谢间接相关，语义相似度高但无明确强语义关系。"}, {"source": "《素问》", "target": "脾胃", "type": "related", "description": "《素问》系统论述了脾胃的运化、与肺肝肾等脏腑的协同关系及劳逸致病机制，两者内容高度相关。"}, {"source": "四诊", "target": "脾胃", "type": "related", "description": "四诊通过望闻问切收集病情资料，可反映脾胃功能状态，两者在中医诊断与脏腑理论中密切相关。"}, {"source": "水肿", "target": "血瘀证", "type": "related", "description": "水肿常与瘀血相兼为病，血瘀可致水停，二者在病理上相互影响，属于相关关系。"}, {"source": "心肺", "target": "气闭", "type": "related", "description": "心肺功能涉及气机布散，气闭为气机闭阻不通，两者均属气机失调范畴，语义高度相关但无直接特定关系。"}, {"source": "气滞血瘀", "target": "津液不足", "type": "related", "description": "气滞血瘀与津液不足均为中医病理状态，语义高度相似且可相互影响（气滞可致津停，津亏可致血瘀），但无直接先修或包含关系。"}, {"source": "气能生津", "target": "津亏", "type": "related", "description": "气能生津与津亏是气血津液关系中相互影响的因果相关概念，气能生津不足可致津亏，津亏亦可致气衰。"}, {"source": "《素问》", "target": "脾", "type": "related", "description": "《素问》系统论述了脾的功能与作用，两者是经典与核心概念的高度关联。"}, {"source": "水肿", "target": "滋润", "type": "related", "description": "两者均涉及津液代谢与气化功能，水肿为病理状态，滋润为正常功能，语义高度相关但非强语义关系。"}, {"source": "气机升降", "target": "气滞血瘀", "type": "related", "description": "气机升降失常是气滞血瘀的重要成因之一，两者存在明确的因果关系，但无更强语义关系。"}, {"source": "官窍", "target": "水肿", "type": "related", "description": "官窍与水肿均涉及津液代谢和气化功能异常，但官窍为结构，水肿为病理状态，无直接包含或因果，属高度相关。"}, {"source": "气滞血瘀", "target": "疾病", "type": "example-of", "description": "气滞血瘀是疾病的一种具体病理状态或证候，属于疾病的实例。"}, {"source": "中病即止", "target": "虚证", "type": "related", "description": "中病即止是治疗原则，虚证是证型，两者在中医临床中密切相关：虚证患者运用攻邪法时更需遵循中病即止以防伤正。"}, {"source": "张景岳", "target": "脾胃", "type": "related", "description": "张景岳的阴阳辨证与命门学说在中医理论体系中与脾胃的生理病理密切关联，但无直接的先修、包含或实例关系。"}, {"source": "气能生津", "target": "水谷之精", "type": "related", "description": "水谷之精是气能生津中津液生成的物质本源，二者具有强相关关系。"}, {"source": "呼吸运动", "target": "脾胃", "type": "related", "description": "呼吸运动（肺主呼气）与脾胃（脾运化水谷精微）通过宗气生成形成直接关联，描述中明确提及肺呼吸功能与脾运化功能直接关联。"}, {"source": "水液代谢", "target": "血瘀证", "type": "related", "description": "水液代谢失常可导致水湿内停，湿阻气机进而引起血瘀，两者在中医病理机制上密切相关。"}, {"source": "卫气", "target": "呕血", "type": "related", "description": "两者均属中医气血津液范畴，卫气为防御之气，呕血为出血症状，病机中气逆、气虚可致出血，语义高度相关但无更强关系。"}]}