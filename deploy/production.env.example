ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=
USE_SQLITE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=competition_app
MYSQL_PASSWORD=
MYSQL_DATABASE=competition_app
BACKEND_HANDOFF_MYSQL_DATABASE=competition_frontend
CHAT_BASE_URL=
CHAT_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=1800
EMBEDDING_MODE=enabled
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_API_KEY=
SHIZHEN_ASSET_ROOT=/srv/shizhen/assets
SHIZHEN_ASSET_RELEASE=2026-07-18
SHIZHEN_ATLAS_CHAPTER_RELEASE=2026-07-22
SHIZHEN_RUNTIME_ROOT=/srv/shizhen/runtime
RUNTIME_ROOT=/srv/shizhen/runtime/competition_app
BACKEND_HANDOFF_RUNTIME_ROOT=/srv/shizhen/runtime/frontend_backend
KNOWLEDGE_RUNTIME_ROOT=/srv/shizhen/runtime/knowledge
