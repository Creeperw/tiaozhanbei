MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_SSL_TLS=true
MAIL_STARTTLS=false
EVOLUTION_ENABLED=false
