# Copy outside the repository to /etc/shizhen/app.env; chmod 600.
# Blank secrets MUST be supplied privately before starting.
COMPETITION_APP_MODE=live
COMPETITION_EXECUTION_ENGINE=langgraph
API_HOST=127.0.0.1
API_PORT=7860
FRONTEND_DIST_ROOT=/srv/shizhen/app/frontend/llm/dist
BACKEND_HANDOFF_ENABLED=true
PLATFORM_BACKEND_ROOT=/srv/shizhen/app/backend/platform_backend
AUTH_COOKIE_SECURE=true
SECRET_KEY=
BACKEND_HANDOFF_SECRET_KEY=
