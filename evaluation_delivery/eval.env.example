# 评测判定通道环境变量模板
# 复制为 eval.env 并填写真实值：cp eval.env.example eval.env
# 注意：本文件只配置"判定通道"（Judge/Embedding）；框架模型链路仍用
#       backend/competition_app/.env.local 的配置。

# LLM Judge（DeepSeek）
EVAL_JUDGE_BASE_URL=https://api.deepseek.com
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=deepseek-v4-flash
EVAL_JUDGE_TIMEOUT=60

# Embedding（SiliconFlow，覆盖率通道 A 用）
EVAL_EMBED_BASE_URL=https://api.siliconflow.cn/v1
EVAL_EMBED_API_KEY=
EVAL_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
