# Copy this file to .env.local and fill local secrets there. Never commit secrets.
COMPETITION_APP_MODE=stub
COMPETITION_EXECUTION_ENGINE=langgraph
API_HOST=127.0.0.1
API_PORT=7860
RUNTIME_ROOT=backend/competition_app/runtime
FRONTEND_DIST_ROOT=frontend/llm/dist

# Main model stack. Incoming config_new.py model endpoints are not used.
CHAT_BASE_URL=https://llm-298mleun258tyc3o.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 按顺序尝试；配额、限流、模型不可用、响应不兼容或持续异常时切到下一项。
CHAT_MODELS=qwen3.7-flash,qwen3.7-max-preview,glm-5.2,qwen3.7-flash-2026-07-15,qwen-plus
# 兼容旧部署；设置 CHAT_MODELS 后无需再设置 CHAT_MODEL。
CHAT_MODEL=
# 统一 LLM API Key（chat 模型专用）。旧变量名 DASHSCOPE_API_KEY /
# DEEPSEEK_API_KEY / SILICONFLOW_API_KEY 仍兼容，但新部署请只使用 LLM_API_KEY。
LLM_API_KEY=
# 备用密钥，按顺序用逗号分隔；仅在服务端明确返回余额/配额耗尽时切换。
LLM_API_KEYS=
LLM_TIMEOUT_SECONDS=1800

# Server-local debug trace (OFF by default). This may contain sanitized but
# sensitive prompt/response diagnostics; configure only on the server, never
# expose it to the browser, and disable/remove it after reproducing an issue.
# In live mode both ENABLED=true and ALLOW_LIVE=true are required deliberately.
COMPETITION_DEBUG_TRACE_ENABLED=false
COMPETITION_DEBUG_TRACE_ALLOW_LIVE=false
COMPETITION_DEBUG_TRACE_ROOT=debug_traces
COMPETITION_DEBUG_TRACE_MAX_BYTES=16777216
COMPETITION_DEBUG_TRACE_ROTATE_BYTES=4194304
COMPETITION_DEBUG_TRACE_FLUSH=true
# Empty captures every run; otherwise use exact run/execution IDs separated by commas.
COMPETITION_DEBUG_TRACE_RUN_IDS=

# 向量编码（embedding）模型 API 配置，独立于 chat 模型
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_API_KEY=
# 默认启用。若部署机有本地模型可填写路径，否则使用上面的远程 Embedding。
EMBEDDING_MODE=enabled
EMBEDDING_MODEL_PATH=

# MySQL remains the authoritative persistent store. Empty password uses in-memory
# repositories in stub mode. SQLite fields are reserved for incoming modules.
USE_SQLITE=false
DATABASE_URL=
SQLITE_PATH=competition_app.sqlite3
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=competition_app
MYSQL_PASSWORD=
MYSQL_DATABASE=competition_app
BACKEND_HANDOFF_MYSQL_DATABASE=competition_frontend

AUTH_SESSION_TTL_HOURS=720
# HTTPS deployment: true. Local HTTP development: false.
AUTH_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sining.local
ADMIN_DEFAULT_PASSWORD=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public assets are read-only; runtime, uploads and user indexes are writable.
# Relative unified roots are resolved from the repository root. Existing
# deployments may keep the detailed legacy variables below during migration.
SHIZHEN_ASSET_ROOT=
SHIZHEN_RUNTIME_ROOT=
SHIZHEN_ASSET_MANIFEST=
SHIZHEN_ASSET_RELEASE=2026-07-18
SHIZHEN_ATLAS_CHAPTER_RELEASE=2026-07-22
QUESTION_VECTOR_STORE_ROOT=
KNOWLEDGE_VECTOR_STORE_ROOT=
KNOWLEDGE_RELEASE_ROOT=
KNOWLEDGE_RUNTIME_ROOT=
KNOWLEDGE_ATLAS_ENABLED=true
KNOWLEDGE_ATLAS_ASSET_VERSION=2026-07-18
KNOWLEDGE_ATLAS_DATA_ROOT=
KNOWLEDGE_ATLAS_VIDEO_ROOT=
KNOWLEDGE_ATLAS_CONTRACT_PATH=
KNOWLEDGE_ATLAS_CHAPTER_ROOT=
OFFICIAL_EXAM_DATA_DIR=
TEXTBOOK_PDF_ROOT=
TEXTBOOK_PDF_CATALOG_PATH=backend/competition_app/data/textbook_pdfs/catalog.v1.json
# MinerU 密钥只保存在服务端；兼容 MINERU_API_KEY。
MINERU_TOKEN=

# Existing online search is retained.
EXA_API_KEY=
# 遗留兼容项，当前知识库检索实际生效条数由 KNOWLEDGE_RETRIEVAL_EXA_LIMIT 控制。
EXA_NUM_RESULTS=3
EXA_CONTENT_CHAR_LIMIT=500

# Knowledge base retrieval tuning. 知识库检索参数，全部可通过环境变量统一调整。
# 补充检索轮数：1 = 仅初始检索，2 = 初始 + 1 轮补充，以此类推。
KNOWLEDGE_SUPPLEMENT_MAX_ROUNDS=2
# 每轮补充检索最多生成多少个查询。
KNOWLEDGE_SUPPLEMENT_MAX_QUERIES=3
# 补充查询文本的最大长度（字符），超长、空或重复的查询会被丢弃。
KNOWLEDGE_SUPPLEMENT_QUERY_MAX_LENGTH=200
# Exa 外部检索（视频/论文/网页/题库）每类返回的条数。
KNOWLEDGE_RETRIEVAL_EXA_LIMIT=3
# 教材/知识库检索返回的条数。
KNOWLEDGE_RETRIEVAL_TEXTBOOK_LIMIT=5

# 追责评测专用故障注入：正式环境必须保持关闭。启用后仍需登录、内部接口和密钥。
ACCOUNTABILITY_EVALUATION_ENABLED=false
ACCOUNTABILITY_EVALUATION_TOKEN=

# 失败驱动多智能体进化。治理、运行时规则和训练平台分开启用，默认均关闭。
# 关闭或读取失败时必须回退原有多智能体行为。
EVOLUTION_ENABLED=false
EVOLUTION_RULES_ENABLED=false
EVOLUTION_DATA_ROOT=
EVOLUTION_MIN_CASES=3
EVOLUTION_MIN_EXECUTIONS=2
EVOLUTION_MIN_HIGH_TRUST=2
# 偏好训练是附加产品；DPO Worker 默认禁止，Web 进程不执行任意训练命令。
PREFERENCE_TRAINING_ENABLED=false
PREFERENCE_TRAINING_ALLOW_TRL_DPO=false

# Selected incoming file/image/mail capabilities. Voice model loading is disabled
# for the current integration phase and intentionally has no configuration here.
UPLOAD_DIR=uploads
METADATA_FILE=file_metadata.json
MARKITDOWN_OUTPUT_DIR=markitdown_output
MARKITDOWN_EXTRACT_TIMEOUT_SECONDS=120
MAX_TEXT_LENGTH=3000
VISION_API_BASE_URL=
VISION_API_MODEL=qwen3-vl-flash
VISION_API_KEY=
VISION_API_TIMEOUT_SECONDS=30
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.qq.com
MAIL_STARTTLS=false
MAIL_SSL_TLS=true

# Integrated business backend. The old BACKEND_HANDOFF_ROOT name remains
# accepted for compatibility; new deployments use the neutral setting below.
BACKEND_HANDOFF_ENABLED=true
PLATFORM_BACKEND_ROOT=platform_backend
BACKEND_HANDOFF_RUNTIME_ROOT=competition_app/runtime/frontend_backend
BACKEND_HANDOFF_MYSQL_DATABASE=competition_frontend
BACKEND_HANDOFF_SECRET_KEY=
